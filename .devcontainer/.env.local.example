# Notion CLI (`ntn`): Linux ヘッドレス環境で OS キーリングを使わない設定
NOTION_KEYRING=0

# Server Dev Container 向け設定
ORCA_PAIRING_ADDRESS=<Docker host Tailscale IPv4>
OP_SERVICE_ACCOUNT_TOKEN=<1Password Service Account Auth Token>
SSH_PUB_KEY=<Your SSH public key>

# 各種 API トークン（平文または 1Password 参照 op://... を設定）
# Notion CLI (`ntn`) — `ntn pages` に必須、ヘッドレス／エージェント実行でも推奨
NOTION_API_TOKEN=
# Linear CLI (`linearis` / `linear`)
LINEAR_API_TOKEN=
