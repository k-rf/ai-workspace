{
  "name": "ai-workspace-editor",
  "remoteUser": "ai-workspace",
  "dockerComposeFile": "../compose.dev.yaml",
  "initializeCommand": ".devcontainer/script/initialize-command.sh",
  "postCreateCommand": ".devcontainer/editor/script/post-created-command.sh ${localEnv:HOME}",
  "service": "editor",
  "runServices": ["editor"],
  "features": {
    "ghcr.io/itsmechlark/features/1password": "latest",
    "ghcr.io/devcontainers/features/github-cli": "latest",
    "ghcr.io/devcontainers/features/docker-outside-of-docker": {
      "version": "latest",
      "moby": false
    }
  },
  "workspaceFolder": "/workspaces/ai-workspace",
  "overrideCommand": true,
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "albymor.increment-selection",
        "bodil.file-browser",
        "bokuweb.vscode-ripgrep",
        "charliermarsh.ruff",
        "christian-kohler.path-intellisense",
        "DavidAnson.vscode-markdownlint",
        "eamodio.gitlens",
        "foxundermoon.shell-format",
        "GitHub.copilot-chat",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "Google.gemini-cli-vscode-ide-companion",
        "google.geminicodeassist",
        "Gruntfuggly.todo-tree",
        "ipatalas.vscode-postfix-ts",
        "irongeek.vscode-env",
        "kahole.magit",
        "mhutchie.git-graph",
        "mikestead.dotenv",
        "ms-azuretools.vscode-containers",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "mutantdino.resourcemonitor",
        "Perkovec.emoji",
        "redhat.vscode-yaml",
        "shd101wyy.markdown-preview-enhanced",
        "streetsidesoftware.code-spell-checker",
        "tamasfe.even-better-toml",
        "wmaurer.change-case",
        "yoavbls.pretty-ts-errors",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/ai-workspace/.venv/bin/python"
      }
    }
  }
}
