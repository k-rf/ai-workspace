# Copy to .env (gitignored) and populate tokens locally. Never commit real secrets.

# Notion CLI (`ntn`) - required for `ntn pages` and recommended for headless/agent runs.
# Create a token at https://www.notion.so/profile/integrations
NOTION_API_TOKEN=
# Optional on headless Linux when using `ntn login --no-browser` instead of NOTION_API_TOKEN:
# NOTION_KEYRING=0
# NOTION_HOME=

# Linear CLI (`linearis` / `linear`) - recommended for headless/agent runs.
# Create a personal API key in Linear Settings -> Security & access -> Personal API keys
LINEAR_API_TOKEN=
