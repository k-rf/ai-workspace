# .env にコピー（gitignore 対象）し、ローカルまたは環境変数でトークンを設定してください。
# 実トークンをリポジトリへコミットしないでください。

# Notion CLI (`ntn`) — `ntn pages` に必須、ヘッドレス／エージェント実行でも推奨
# https://www.notion.so/profile/integrations からトークンを作成できます
NOTION_API_TOKEN=
# NOTION_API_TOKEN の代わりに Linux ヘッドレス環境で `ntn login --no-browser` を使う場合のオプション:
# NOTION_KEYRING=0
# NOTION_HOME=

# Linear CLI (`linearis` / `linear`) — ヘッドレス／エージェント実行で推奨
# Linear の Settings -> Security & access -> Personal API keys から作成できます
LINEAR_API_TOKEN=
